#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════════════
#  faded-notifications — waybar notification bell backed by dunst
#  (replaces upstream's swaync-client -swb bell)
#
#  Mirrors the upstream state names so the same format-icons work:
#    notification / none / dnd-notification / dnd-none
#
#  Needs: dunst (dunstctl). Install to: ~/.local/bin/faded-notifications
# ════════════════════════════════════════════════════════════════════════════
set -u

command -v dunstctl >/dev/null 2>&1 || { printf '{"text":"󰂜","class":"none","alt":"none"}\n'; exit 0; }

out=$(dunstctl count 2>/dev/null || true)
disp=$(printf '%s' "$out" | awk 'tolower($0) ~ /displayed/ {gsub(/[^0-9]/,"",$2); print $2+0}')
wait=$(printf '%s' "$out" | awk 'tolower($0) ~ /waiting/    {gsub(/[^0-9]/,"",$2); print $2+0}')
total=$(( ${disp:-0} + ${wait:-0} ))

paused="false"
dunstctl is-paused 2>/dev/null | grep -qi true && paused="true"

if [ "$paused" = "true" ]; then
    if [ "$total" -gt 0 ]; then cls="dnd-notification"; else cls="dnd-none"; fi
else
    if [ "$total" -gt 0 ]; then cls="notification"; else cls="none"; fi
fi

tip="No notifications"
[ "$total" -gt 0 ] && tip="$total notification(s) waiting"

# NOTE: waybar picks format-icons by the JSON "alt" field (this is what
# swaync-client -swb emitted upstream), so the state MUST go in "alt".
printf '{"text":"","class":"%s","alt":"%s","tooltip":"%s"}\n' "$cls" "$cls" "$tip"

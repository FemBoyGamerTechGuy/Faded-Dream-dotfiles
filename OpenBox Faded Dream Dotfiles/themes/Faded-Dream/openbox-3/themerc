window.active.button.hover.bg.color: #EC407A
window.active.button.hover.image.color: #FFFFFF
window.active.button.toggled.unpressed.bg: Flat Solid
window.active.button.toggled.unpressed.bg.color: #212121
window.active.button.toggled.unpressed.image.color: #00FF99
window.active.button.toggled.hover.bg: Flat Solid
window.active.button.toggled.hover.bg.color: #EC407A
window.active.button.toggled.hover.image.color: #FFFFFF

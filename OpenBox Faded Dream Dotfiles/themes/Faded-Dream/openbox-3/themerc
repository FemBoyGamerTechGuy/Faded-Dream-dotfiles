# ══════════════════════════════════════════════════════════════════════════
#  Faded Dream — OpenBox 3 theme
#  Port of FemBoyGamerTechGuy's "Faded Dream" Hyprland look to X11.
#
#  Palette mapping from upstream:
#    • Active window deco : cyan→green 45° gradient
#        (hyprland active_border  rgba(33ccffee) → rgba(00ff99ee), angle 45)
#        → titlebar "Flat Gradient Diagonal" #33CCFF → #00FF99
#    • Active border      : #33CCFF  (solid — ob borders can't gradient)
#    • Inactive border    : #595959  (upstream inactive_border)
#    • Surfaces           : #212121 / #2A2A2A  (rofi rounded-pink-dark bg)
#    • Accent / selection : #EC407A  (rofi pink)
#    • Text                : #E6E6E6  (rofi fg)
#
#  Install to: ~/.themes/Faded-Dream/openbox-3/themerc
# ══════════════════════════════════════════════════════════════════════════

### Window geometry
border.width: 2
padding.width: 2
padding.height: 2
window.client.padding.width: 0
window.client.padding.height: 0
window.handle.width: 4

### Menu geometry
menu.overlap.x: 0
menu.overlap.y: 0
menu.border.width: 1
menu.border.color: #3D3D3D
menu.separator.width: 1
menu.separator.padding.width: 4
menu.separator.padding.height: 4
menu.items.padding.x: 10
menu.items.padding.y: 4

### ─── Active window (the Faded Dream gradient) ───────────────────────────
window.active.border.color: #33CCFF
window.active.title.separator.color: #33CCFF

# the 45° cyan→green gradient, straight from the Hyprland border config
window.active.title.bg: Flat Gradient Diagonal
window.active.title.bg.color: #33CCFF
window.active.title.bg.colorTo: #00FF99

window.active.label.text.color: #10161B

window.active.handle.bg: Flat Gradient Diagonal
window.active.handle.bg.color: #33CCFF
window.active.handle.bg.colorTo: #00FF99
window.active.grip.bg: Flat Gradient Diagonal
window.active.grip.bg.color: #33CCFF
window.active.grip.bg.colorTo: #00FF99

